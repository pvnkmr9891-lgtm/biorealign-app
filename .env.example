# Copy this to .env and fill in your values
# Never commit .env to git

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Crash reporting + analytics (app runs fine with these unset — telemetry just stays off)
# Sentry: Project Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=
# PostHog: Project Settings → Project API Key (starts with phc_)
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# These stay server-side only (Edge Functions, not in the app)
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
