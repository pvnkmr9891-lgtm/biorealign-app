{
  "expo": {
    "name": "BioRealign",
    "slug": "biorealign-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "biorealign",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.biorealign.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for posture assessment photos.",
        "NSPhotoLibraryUsageDescription": "Used to upload progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      },
      "package": "com.biorealign.app",
      "newArchEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
  "expo-router",
  "expo-secure-store",
  "expo-font",
  "expo-notifications"
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0d827ce-cc40-4260-9cf2-bedac9ee12ec"
      }
    },
    "owner": "pvnkmr9891-lgtm"
  }
}
