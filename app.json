{
  "expo": {
    "name": "BioRealign",
    "slug": "biorealign-app",
    "version": "1.0.0",
    "scheme": "biorealign",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/b0d827ce-cc40-4260-9cf2-bedac9ee12ec"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.biorealign.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for posture assessment photos.",
        "NSPhotoLibraryUsageDescription": "Used to upload progress photos."
      }
    },
    "android": {
      "package": "com.biorealign.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "root": "app" }],
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-asset",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0d827ce-cc40-4260-9cf2-bedac9ee12ec"
      }
    },
    "owner": "pvnkmr9891-lgtm",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
